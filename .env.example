# Copy to .env and fill. Never commit .env. One block per chain you want to run.
# `npx txfinality wallet --chain solana` fills the key line for you. The recipient is derived from it.
SOLANA_RPC_URL=
# the sender's secret key: base58 (as wallets export it) or a JSON array (as solana-keygen writes it)
SOLANA_FROM_KEY=
ETHEREUM_RPC_URL=
