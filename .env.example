# Copy to .env and fill. Never commit .env. One block per chain you want to run.
# `npx txfinality wallet --chain solana` fills the key line for you. The recipient is derived from it.
SOLANA_RPC_URL=
# the sender's secret key: base58 (as wallets export it) or a JSON array (as solana-keygen writes it)
SOLANA_FROM_KEY=
ETHEREUM_RPC_URL=
# EVM chains: one key for all of them (the same sender address on every chain), one RPC URL each
EVM_FROM_KEY=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BNB_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=
PLASMA_RPC_URL=
HYPEREVM_RPC_URL=
XLAYER_RPC_URL=
ROBINHOOD_RPC_URL=
