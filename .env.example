# Copy to .env and fill. Never commit .env. One block per chain you want to run.
# `npx txfinality wallet --chain solana` fills the three wallet lines for you.
SOLANA_RPC_URL=
# the sender's secret key: base58 (as wallets export it) or a JSON array (as solana-keygen writes it)
SOLANA_FROM_KEY=
# the recipient: a second wallet of yours
SOLANA_TO_ADDRESS=
# optional: the recipient's secret key, kept so the USDC can be moved back
SOLANA_TO_KEY=
ETHEREUM_RPC_URL=
