# Copy to .env and fill in. Never commit .env. One block per chain you want to run; leave the rest empty.
# `npx txfinality wallet --chain <id>` writes the key line for you; the recipient is derived from the key.

# --- Solana
SOLANA_RPC_URL=
# the sender's secret key: base58 (as wallets export it) or a JSON array (as solana-keygen writes it)
SOLANA_FROM_KEY=

# --- EVM chains: one key for all of them (the same sender address on every chain), one read endpoint each.
# A rollup also takes a send endpoint (the chain's own RPC): sends and the pending nonce go there, so a
# third-party reader that does not forward to the sequencer still works for reads.
EVM_FROM_KEY=
BASE_RPC_URL=
BASE_SEND_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=
ARBITRUM_SEND_RPC_URL=https://arb1.arbitrum.io/rpc
BNB_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=
PLASMA_RPC_URL=
HYPEREVM_RPC_URL=
ARC_RPC_URL=
XLAYER_RPC_URL=
XLAYER_SEND_RPC_URL=https://rpc.xlayer.tech
ROBINHOOD_RPC_URL=
ROBINHOOD_SEND_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Ethereum is listed by design and not measured; `txfinality watch --chain ethereum` (read-only) needs this
ETHEREUM_RPC_URL=
# Tron and Bitcoin are listed by design: their chain files name variables, but no driver reads them yet

# --- TON: a TON Center-compatible API base (https://toncenter.com, or a provider's base URL), and TON Center's
# key header when you have one (without a key the public endpoint allows one request a second)
TON_API_URL=https://toncenter.com
TON_API_KEY=
# the sender's 32-byte seed, hex (a v4 wallet, deployed by its first outgoing message)
TON_FROM_KEY=

# --- XRP Ledger: a JSON-RPC endpoint
XRPL_RPC_URL=https://xrplcluster.com
# the sender's family seed (sEd...)
XRPL_FROM_KEY=

# --- Aptos: the full node REST base and, if you have one, an API key sent as a bearer token
APTOS_API_URL=https://api.mainnet.aptoslabs.com/v1
APTOS_API_KEY=
# the sender's ed25519 private key, hex
APTOS_FROM_KEY=
